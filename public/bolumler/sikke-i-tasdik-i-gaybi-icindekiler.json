 {
  "seviye": 1,
  "baslik": "Sekizinci Şuâ",
  "aciklama": "Hz.Ali'nin (r.a.) Risâle-i Nur'a dair kerâmetkârâne müjdelerinden üçüncüsünü açıklayan bir risaledir. Bu arada, Bediüzzaman, Risâle-i Nur'un kıymet ve önemini gösteren hakikatleri açıklamasının sebep ve hikmetlerini de burada belirtmektedir.",
  "sayfa": 127,
  "oran": 0.0
 },
 {
  "seviye": 1,
  "baslik": "Yirmi Sekizinci Lem'anın Birinci Meselesi",
  "aciklama": "Risale-i Nurdan haber veren İkinci Keramet-i Aleviye Risalesidir.",
  "sayfa": 158,
  "oran": 0.1
 },
 {
  "seviye": 1,
  "baslik": "On Sekizinci Lem'a",
  "aciklama": "Gizli kalmış mühim bir Peygamber (a.s.m.) mu'cizesini açıklayan ve evliyânın kerametlerinin hak olduğuna kesin bir delil teşkil eden Hz. Ali'nin (r.a.) gaybî bir kerametini açıklayan Birinci Keramet-i Aleviye Risâlesi isminde bir lem'adır.",
  "sayfa": 177,
  "oran": 0.0
 },
 {
  "seviye": 1,
  "baslik": "Sekizinci Lem'a",
  "aciklama": "Hûd Sûresi 105. ve 112. âyetlerinin tefsiri mâhiyetinde olan bu risâle, Gavs-ı Âzam Abdülkadir Geylanî'nin kerâmet-i gaybiyesiyle Kur'ân'ın esrârına âit olan Risale-i Nur'un makbuliyetini gösterir ve bu zamanın Kur'ân hizmetkârlarına işaretle beraber onların mânevî güçlerini ve şevklerini artıran, sıkıntılarını gideren lem'adır.",
  "sayfa": 190,
  "oran": 0.0
 },
 {
  "seviye": 1,
