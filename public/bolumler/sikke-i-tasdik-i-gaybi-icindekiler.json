  "aciklama": "Hava zerrelerindeki İlâhî ilim, irade ve kudret tecellîsini anlatır.",
  "sayfa": 328,
  "oran": 0.0
 },
 {
  "seviye": 1,
  "baslik": "Yirmi Dokuzuncu Mektubun Beşinci Risale olan Beşinci Kısmı",
  "aciklama": "\"Allah göklerin ve yerin nurudur.\" (Nur Sûresi, 24:35.) âyetine dair.",
  "sayfa": 332,
  "oran": 0.0
 },
 {
